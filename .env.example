# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only used in server-side scripts (e.g. seeding) and by the no-login public
# report page (src/app/public-report/[token], via lib/supabase/admin.ts).
# NEVER expose this to the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secret used only to gate /public-report/[token] (a no-login page for sharing
# the 제품군 분석 report outside the team, e.g. with a manager). Generate a
# long random value yourself (e.g. `openssl rand -base64 24`) and treat it like
# a password: whoever has the URL with this token can view the report, no
# login required. Rotate by changing this value and redeploying.
PUBLIC_REPORT_TOKEN=your-long-random-token

# Brand-partner application (/partner-apply/[invite]). The invite code goes in
# the link you send to facilities; anyone with the link can apply, no login.
# Generate with `openssl rand -hex 24` (URL-safe). Rotate by changing the value
# and redeploying.
PARTNER_APPLY_INVITE_TOKEN=your-invite-code

# 32-byte key (base64) that encrypts applicants' bank account numbers.
# Generate once with `openssl rand -base64 32` and keep a copy somewhere safe:
# if this key is lost, stored account numbers can no longer be decrypted.
PARTNER_DATA_KEY=your-base64-32-byte-key
